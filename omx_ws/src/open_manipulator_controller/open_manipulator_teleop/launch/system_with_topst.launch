<launch>

  <!-- ① TOPST-D3 USB → ROS 브리지 -->
  <node pkg="order_manager" type="serial_to_ros.py" name="serial_bridge">
    <param name="port" value="/dev/ttyUSB0"/>
    <param name="baud" value="115200"/>
  </node>

  <!-- ② 커피 사이클 실행 -->
  <include file="$(find open_manipulator_teleop)/launch/coffee_cycle_executor.launch"/>

  <!-- ③ 매니퓰레이터 매니저 -->
  <include file="$(find order_manager)/launch/order_manager.launch"/>

</launch>
